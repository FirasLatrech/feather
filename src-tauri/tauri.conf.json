{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feather",
  "version": "0.1.0",
  "identifier": "tn.horizon-tech.feather",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && sh scripts/build-cli.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Feather",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mov",
          "m4v",
          "mkv",
          "webm",
          "avi",
          "flv",
          "ts",
          "mts",
          "m2ts",
          "wmv",
          "mpg",
          "mpeg"
        ],
        "name": "Video",
        "description": "Video file",
        "role": "Viewer"
      },
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "webp",
          "avif",
          "heic",
          "heif",
          "tif",
          "tiff",
          "bmp"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer"
      },
      {
        "ext": [
          "gif"
        ],
        "name": "GIF",
        "description": "GIF image",
        "role": "Viewer"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF",
        "description": "PDF document",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "category": "public.app-category.utilities",
    "shortDescription": "Make videos, images, GIFs and PDFs lighter \u2014 on your device.",
    "externalBin": [
      "binaries/feather-cli"
    ]
  }
}
